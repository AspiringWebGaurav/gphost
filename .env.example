# ==============================================================================
# GPHosting Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# All variables should be configured in your Vercel Project Settings for production:
# https://vercel.com/docs/projects/environment-variables
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Fallback alias: NEXT_PUBLIC_SUPABASE_ANON_KEY (Supported for Vercel Supabase integration)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Fallback alias: SUPABASE_SERVICE_ROLE_KEY (Supported for Vercel Supabase integration)

# App Base URL (Official domain: https://gphost.eu.cc)
NEXT_PUBLIC_APP_URL=https://gphost.eu.cc

# Cloudflare R2 Configuration (S3-Compatible Object Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Optional: Secret token for validating incoming Cloudflare R2 Webhook events (/api/webhooks/r2)
R2_WEBHOOK_SECRET=your_r2_webhook_secret_here

# Upstash Redis REST Configuration (Rate Limiting & Lease Locks)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Cloudflare Turnstile Bot Defense
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Admin Email (Used to identify the primary owner account)
ADMIN_EMAIL=admin@example.com

# Optional: Reconciliation Secret for manual or webhook calls to /api/files/reconcile-single-use
CRON_SECRET=generate_a_random_32_character_string_here

# XURL URL Shortener Integration
XURL_API_URL=https://xurl.eu.cc/api/v1
XURL_API_KEY=your_xurl_api_key
# Optional: Target base URL for XURL short links during local development (e.g. Cloudflare Tunnel / ngrok)
# If unset while running on localhost, dev mode automatically simulates active short links.
# XURL_TARGET_BASE_URL=https://your-tunnel.trycloudflare.com
# XURL_DEV_MOCK=true

# Switchyy Mode Control
NEXT_PUBLIC_SWITCHYY_PUBLIC_KEY=your_switchyy_public_key
NEXT_PUBLIC_SWITCHYY_PROJECT_ID=your_switchyy_project_id

# Security Salt & Pepper (Must be a stable 64-char random hex string across all environments)
PIN_PEPPER=generate_a_random_64_character_hex_string_here
# Optional dedicated security peppers (falls back to PIN_PEPPER if unset):
# PASSWORD_PEPPER=generate_a_random_64_character_hex_string_here
# UNLOCK_TOKEN_SECRET=generate_a_random_64_character_hex_string_here
