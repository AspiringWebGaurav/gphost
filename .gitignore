# ==============================================================================
# GPHOST - Comprehensive .gitignore
# Next.js 16 (Turbopack) | TypeScript | TailwindCSS | Supabase | Vercel
# ==============================================================================

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.vault
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Dependencies & Package Managers ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/

# --- Next.js Build Output & Caches ---
/.next/
/out/
/build/
/dist/
.turbo/

# --- Deployment & Cloud Platforms ---
.vercel/
.netlify/
.wrangler/

# --- TypeScript Build Cache ---
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Testing, Playwright & E2E Suites ---
/coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/
playwright.config.ts
tests/
*benchmark-results*.json
benchmark-results.json

# --- Debug & Runtime Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
.eslintcache
*.pid
*.seed
*.pid.lock
.npm
.node_repl_history

# --- Supabase Local CLI & Caches ---
supabase/.temp/
supabase/.branches/
.temp/
**/.temp/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# --- Agent Governance, IDE & Local Scratch ---
.agent/
.agents/
.gemini/
scratch/
scratch_*
*.scratch.*
AGENTS.md
CLAUDE.md
GEMINI.md

# --- Temporary, Backup & Archive Files ---
*.backup
*.tmp
*.bak
*.zip
*.tar.gz

# --- Local Maintenance & Cleanup Scripts (Kept local, excluded from repo) ---
/clean.sh
/Makefile
/scripts/clean.sh
/scripts/Makefile
